# Example environment variables for EduTrack.
# Copy this file to `.env` and fill in your local MySQL credentials.
# Do NOT commit your real credentials into version control.

EDUTRACK_DB_HOST=localhost
EDUTRACK_DB_USER=root
EDUTRACK_DB_PASSWORD=your_password_here
EDUTRACK_DB_NAME=edutrack
EDUTRACK_DB_PORT=3306

# Optional: path to a CA bundle to require a verified TLS connection to MySQL.
# EDUTRACK_DB_SSL_CA=/path/to/ca.pem
